-- TOC entry 4985 (class 2618 OID 16541)
-- Name: v_project_financials _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.v_project_financials AS
 SELECT p.id,
    p.name AS project_name,
    count(DISTINCT a.employee_id) AS employees_count,
    COALESCE(sum((((e.base_rate * (a.hours_worked)::double precision) * pr.coefficient) / (160)::double precision)), (0)::double precision) AS estimated_payroll
   FROM (((public.project p
     JOIN public.assignment a ON ((p.id = a.project_id)))
     JOIN public.employee e ON ((a.employee_id = e.id)))
     JOIN public.project_role pr ON ((a.role_id = pr.id)))
  WHERE ((a.status)::text = 'ACTIVE'::text)
  GROUP BY p.id;


