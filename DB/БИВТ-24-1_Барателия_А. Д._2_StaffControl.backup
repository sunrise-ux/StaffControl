-- TOC entry 233 (class 1255 OID 16490)
-- Name: archive_completed_projects(); Type: PROCEDURE; Schema: public; Owner: postgres
--

CREATE PROCEDURE public.archive_completed_projects()
    LANGUAGE plpgsql
    AS $$
BEGIN
    UPDATE project 
    SET status = 'COMPLETED'
    WHERE end_date < CURRENT_DATE AND status = 'ACTIVE';
    
    -- Логируем действие
    RAISE NOTICE 'Projects archived at %', CURRENT_TIMESTAMP;
END;
$$;


ALTER PROCEDURE public.archive_completed_projects() OWNER TO postgres;

--
-- TOC entry 234 (class 1255 OID 16491)
-- Name: assign_employee_to_project(bigint, bigint, bigint, integer); Type: PROCEDURE; Schema: public; Owner: postgres
--

CREATE PROCEDURE public.assign_employee_to_project(IN p_employee_id bigint, IN p_project_id bigint, IN p_role_id bigint, IN p_hours integer DEFAULT 0)
    LANGUAGE plpgsql
    AS $$
BEGIN
    INSERT INTO assignment (employee_id, project_id, role_id, hours_worked, assigned_date)
    VALUES (p_employee_id, p_project_id, p_role_id, p_hours, CURRENT_DATE)
    ON CONFLICT (employee_id, project_id, role_id) 
    DO UPDATE SET status = 'ACTIVE', hours_worked = EXCLUDED.hours_worked;
    
    RAISE NOTICE 'Employee % assigned to project %', p_employee_id, p_project_id;
END;
$$;


ALTER PROCEDURE public.assign_employee_to_project(IN p_employee_id bigint, IN p_project_id bigint, IN p_role_id bigint, IN p_hours integer) OWNER TO postgres;

--
-- TOC entry 240 (class 1255 OID 16550)
-- Name: calculate_employee_payroll(bigint); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_employee_payroll(p_employee_id bigint) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
    total_payment DECIMAL(15,2);
BEGIN
    SELECT COALESCE(SUM(e.base_rate * a.hours_worked * pr.coefficient), 0)
    INTO total_payment
    FROM assignment a
    JOIN employee e ON a.employee_id = e.id
    JOIN project_role pr ON a.role_id = pr.id
    WHERE a.employee_id = p_employee_id AND a.status = 'ACTIVE';
    
    RETURN total_payment;
END;
$$;


ALTER FUNCTION public.calculate_employee_payroll(p_employee_id bigint) OWNER TO postgres;

--
-- TOC entry 238 (class 1255 OID 16506)
-- Name: check_employee_overload(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.check_employee_overload() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    total_hours INT;
BEGIN
    SELECT COALESCE(SUM(hours_worked), 0) INTO total_hours
    FROM assignment
    WHERE employee_id = NEW.employee_id AND status = 'ACTIVE';
    
    IF total_hours + NEW.hours_worked > 200 THEN
        RAISE EXCEPTION 'Сотрудник перегружен! Максимум 200 часов.';
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.check_employee_overload() OWNER TO postgres;

--
-- TOC entry 235 (class 1255 OID 16492)
-- Name: close_payroll_period(); Type: PROCEDURE; Schema: public; Owner: postgres
--

CREATE PROCEDURE public.close_payroll_period()
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Создаем таблицу для хранения истории выплат (если её нет)
    CREATE TABLE IF NOT EXISTS payroll_history (
        id BIGSERIAL PRIMARY KEY,
        employee_id BIGINT,
        month DATE,
        amount DECIMAL(15,2),
        calculated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    -- Сохраняем расчеты за текущий месяц
    INSERT INTO payroll_history (employee_id, month, amount)
    SELECT 
        a.employee_id,
        DATE_TRUNC('month', CURRENT_DATE)::DATE,
        SUM(e.base_rate * a.hours_worked * pr.coefficient / 160)
    FROM assignment a
    JOIN employee e ON a.employee_id = e.id
    JOIN project_role pr ON a.role_id = pr.id
    WHERE a.status = 'ACTIVE'
    GROUP BY a.employee_id;
    
    RAISE NOTICE 'Payroll period closed for %', CURRENT_DATE;
END;
$$;


ALTER PROCEDURE public.close_payroll_period() OWNER TO postgres;

--
-- TOC entry 232 (class 1255 OID 16488)
-- Name: get_employee_utilization(bigint); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_employee_utilization(p_employee_id bigint) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
    max_hours INT := 160; -- 160 часов в месяц
    actual_hours INT;
BEGIN
    SELECT COALESCE(SUM(hours_worked), 0)
    INTO actual_hours
    FROM assignment
    WHERE employee_id = p_employee_id AND status = 'ACTIVE';
    
    RETURN LEAST((actual_hours::DECIMAL / max_hours) * 100, 100);
END;
$$;


ALTER FUNCTION public.get_employee_utilization(p_employee_id bigint) OWNER TO postgres;

--
-- TOC entry 239 (class 1255 OID 16549)
-- Name: get_project_actual_budget(bigint); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_project_actual_budget(p_project_id bigint) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
    actual_spent DECIMAL(15,2);
    project_budget DECIMAL(15,2);
BEGIN
    SELECT p.budget INTO project_budget FROM project p WHERE p.id = p_project_id;
    
    -- УБРАЛИ деление на 160
    SELECT COALESCE(SUM(e.base_rate * a.hours_worked * pr.coefficient), 0)
    INTO actual_spent
    FROM assignment a
    JOIN employee e ON a.employee_id = e.id
    JOIN project_role pr ON a.role_id = pr.id
    WHERE a.project_id = p_project_id AND a.status = 'ACTIVE';
    
    RETURN project_budget - actual_spent;
END;
$$;


ALTER FUNCTION public.get_project_actual_budget(p_project_id bigint) OWNER TO postgres;

--
-- TOC entry 237 (class 1255 OID 16504)
-- Name: log_assignment_changes(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.log_assignment_changes() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF TG_OP = 'UPDATE' AND OLD.hours_worked != NEW.hours_worked THEN
        INSERT INTO assignment_log (assignment_id, action, old_hours, new_hours)
        VALUES (NEW.id, 'UPDATE', OLD.hours_worked, NEW.hours_worked);
    END IF;
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.log_assignment_changes() OWNER TO postgres;

--
-- TOC entry 236 (class 1255 OID 16493)
-- Name: update_project_status(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_project_status() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.end_date < CURRENT_DATE AND NEW.status = 'ACTIVE' THEN
        NEW.status := 'COMPLETED';
    END IF;
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_project_status() OWNER TO postgres;

