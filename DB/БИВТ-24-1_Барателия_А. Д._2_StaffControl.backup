-- TOC entry 4984 (class 2618 OID 16536)
-- Name: v_employee_utilization _RETURN; Type: RULE; Schema: public; Owner: postgres
--

CREATE OR REPLACE VIEW public.v_employee_utilization AS
 SELECT e.id,
    e.full_name,
    e.email,
    count(a.id) AS projects_count,
    COALESCE(sum(a.hours_worked), (0)::bigint) AS total_hours
   FROM (public.employee e
     LEFT JOIN public.assignment a ON (((e.id = a.employee_id) AND ((a.status)::text = 'ACTIVE'::text))))
  GROUP BY e.id;


