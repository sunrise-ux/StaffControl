CREATE VIEW public.v_assignment_details AS
 SELECT a.id,
    e.full_name AS employee_name,
    p.name AS project_name,
    pr.name AS role_name,
    pr.coefficient AS role_coefficient,
    a.hours_worked,
    (((e.base_rate * (a.hours_worked)::double precision) * pr.coefficient) / (160)::double precision) AS payment_amount
   FROM (((public.assignment a
     JOIN public.employee e ON ((a.employee_id = e.id)))
     JOIN public.project p ON ((a.project_id = p.id)))
     JOIN public.project_role pr ON ((a.role_id = pr.id)));


